# HubSpot Service Key (PAT - Private App Token)
# Get this from: HubSpot Settings → Integrations → Service Keys
# Required scopes: tickets, conversations.read, sales-email-read
HUBSPOT_ACCESS_TOKEN=pat-na2-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Your HubSpot portal ID (find it in your HubSpot URL)
HUBSPOT_PORTAL_ID=

# Number of parallel conversation fetches (default: 10)
# CONCURRENCY=10

# Optional: export only one ticket pipeline, by name or id.
# An unknown value lists the pipelines in your account and exits.
# PIPELINE=Support Pipeline

# Optional: export only tickets created in this year
# YEAR=2025

# Optional: skip conversation threads and export emails only
# SKIP_CONVERSATIONS=true

# Optional: tickets per processing chunk (default: 5000)
# CHUNK_SIZE=5000

# Optional: keep duplicate email/conversation copies of the same message
# SKIP_DEDUPE=true
